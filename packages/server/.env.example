# Copy to .env and fill in. Never commit the real file.
GEMINI_API_KEY=
# Primary model. Built-in fallbacks are tried after it automatically.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: replace the whole preference order, comma separated.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
PORT=8080
ALLOWED_ORIGIN=*
NODE_ENV=development
